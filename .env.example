# Copy to .env.local (git-ignored) for local dev, or set these in your Vercel
# project's Environment Variables. Every one is OPTIONAL: with none set, the app
# runs in "demo mode" — search works (iTunes needs no key), and transcript /
# digest / Q&A endpoints return canned sample content so the whole UI is
# clickable. Add the real keys to light up real episodes.

# --- Claude (digests + follow-up Q&A) ---
# Create at https://console.anthropic.com/settings/keys
# Server-only; never exposed to the browser.
ANTHROPIC_API_KEY=

# Which Claude model to use for digests and Q&A. Defaults to claude-opus-4-8
# (highest quality). For much cheaper runs on long transcripts, set this to
# claude-haiku-4-5. The transcript is prompt-cached, so follow-up questions in a
# session are cheap regardless.
# DIGEST_MODEL=claude-opus-4-8

# --- Speech-to-text (auto-transcription of episodes without a published transcript) ---
# AssemblyAI ingests the episode's audio URL directly (submit + poll), so we
# never download or transcode large audio files inside the serverless function.
# Free tier is generous. Create at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# --- Cache + rate limiting (avoid re-work; protect your keys on a public URL) ---
# Upstash Redis (REST). Free tier. Create at https://upstash.com/
# Without these, transcription/digest still work but nothing is cached (each
# request re-does the expensive work) AND rate limiting is disabled — so if you
# deploy publicly, set these so nobody can run up your Anthropic/AssemblyAI bill.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-IP hourly caps on the paid endpoints (enforced only when Upstash is set).
# LLM covers digest + Q&A; STT covers new audio transcriptions. Defaults shown.
# RL_LLM_PER_HOUR=40
# RL_STT_PER_HOUR=15

# Whole-deployment hourly ceilings across ALL callers combined — the backstop
# that stops many IPs multiplying the per-IP caps into a big bill. Defaults shown.
# RL_LLM_GLOBAL_PER_HOUR=150
# RL_STT_GLOBAL_PER_HOUR=30

# Optional server-only semantic reviews / listening recommendations
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
